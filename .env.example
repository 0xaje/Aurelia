# AssemblyAI API Key for Server-Side Ephemeral Token Minting (Phase 5A)
# DO NOT prefix with VITE_ to ensure the key is NEVER exposed to the browser client.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# LLM Provider Configuration ("ollama" for local runs, or "openrouter")
LLM_PROVIDER=ollama

# Local Ollama Configuration (Default for private, unlimited local run)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# OpenRouter API Key & Model for Server-Side Ora Conversational Intelligence
# Used when LLM_PROVIDER=openrouter. NEVER exposed to browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free


